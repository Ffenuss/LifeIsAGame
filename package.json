{
  "name": "life-estate",
  "private": true,
  "version": "1.0.0",
  "description": "Life Estate - a living 3D board game where every property is a colony.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "sim": "node scripts/simulate.js",
    "store:capture": "node scripts/capture-store.js",
    "android:key": "./scripts/create-upload-key.sh",
    "android:assets": "npm run build && node scripts/sync-android-assets.js",
    "android:debug": "npm run android:assets && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:assets && cd android && ./gradlew bundleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  }
}
