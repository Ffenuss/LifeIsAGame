{
  "name": "life-is-a-game",
  "version": "1.0.0",
  "private": true,
  "description": "A 3D board game about building a life — Monopoly meets The Game of Life.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3002",
    "build": "vite build --base ./",
    "preview": "vite preview --host 0.0.0.0 --port 3002",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/generate-assets.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource/fredoka": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.34.0",
    "vite": "^7.3.7"
  }
}
